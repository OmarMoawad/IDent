NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ident:ident@localhost:5432/ident

# Session 14 (Communications Hub, Gmail connector) — see comms/comms-config.ts.
# Create these in Google Cloud Console (OAuth consent screen + OAuth client,
# Web application type, redirect URI must match GOOGLE_OAUTH_REDIRECT_URI
# below). Never commit real values — this file only holds placeholders.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/identity/connections/gmail/callback

# Optional — comms/comms-config.ts falls back to a fixed dev-only key
# (matching this repo's other dev-default conventions) if unset. Only set
# this for real once the hard gate on real account data is lifted.
COMMS_TOKEN_ENCRYPTION_KEY=

# Session 18: the read-only AI assistant. Provider is Anthropic's Claude
# API (decided with Omar 2026-08-13 — see SECURITY.md § AI Assistant
# Privacy). The assistant is unavailable, not broken, when this is unset.
ANTHROPIC_API_KEY=

# Optional override for the Anthropic model.
ANTHROPIC_MODEL=

# --- Assistant provider (session 21) ---
# The assistant runs against any backend speaking OpenAI's
# /chat/completions shape, which covers Ollama, vLLM, llama.cpp's server,
# and the hosted OpenAI-compatible APIs.
#
# LOCAL MODE (nothing leaves this machine):
#   1. brew install ollama && ollama serve
#   2. ollama pull llama3.2:3b
#   3. ASSISTANT_PROVIDER=local
#
# Leave everything blank and the assistant is simply unavailable — it never
# falls back to a default that would ship data somewhere unchosen.
ASSISTANT_PROVIDER=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
