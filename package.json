{
  "name": "ident",
  "private": true,
  "version": "0.1.0",
  "description": "IDent monorepo \u2014 see README.md and IDent_STATE.md before working here.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:migrations": "node scripts/check-migration-safety.mjs",
    "typecheck": "npm run build -w packages/shared && npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api"
  },
  "engines": {
    "node": ">=20"
  }
}
